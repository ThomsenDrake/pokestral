# Supply your own legally obtained ROM. Red, Blue, and Yellow use the same
# supported Game Boy reader in pokemon-agent.
POKEMON_ROM=./roms/pokemon-blue.gb
POKEMON_DATA_DIR=./.data
POKEMON_HOST=127.0.0.1
POKEMON_PORT=8765
POKEMON_OPEN_DASHBOARD=true

# Leave blank to use the active model from ~/.vibe/config.toml.
POKEMON_VIBE_MODEL=
POKEMON_VIBE_BIN=vibe
POKEMON_VIBE_MAX_TURNS=8
# Optional: uncomment to enforce a per-invocation price ceiling.
# POKEMON_VIBE_MAX_PRICE=0.25
POKEMON_VIBE_TURN_TIMEOUT=900
POKEMON_TURN_DELAY=1.5
POKEMON_AUTOSAVE_EVERY=20

# Cloud mode is enabled by the pinned Koyeb image. Inject credentials through
# privately named deployment secrets; never put their values in this file.
# POKEMON_CLOUD=true
# POKEMON_AUTO_START=true
# POKEMON_GAME_LABEL=Pokemon Blue
# POKEMON_DASHBOARD_USERNAME=trainer
# POKEMON_DASHBOARD_PASSWORD=use-a-separate-secret

# Deployment helpers require these values from your private environment.
# KOYEB_ORGANIZATION_ID=
# KOYEB_APP_NAME=
# KOYEB_SERVICE_NAME=
# POKEMON_EXPECTED_GAME_ID=
# POKEMON_EXPECTED_SESSION_ID=
# POKEMON_EXPECTED_STATE_SHA256=
